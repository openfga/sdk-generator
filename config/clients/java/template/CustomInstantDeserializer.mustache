package {{invokerPackage}};

import java.time.Instant;
import java.time.OffsetDateTime;
import java.time.ZonedDateTime;
import java.time.format.DateTimeFormatter;
import java.time.temporal.Temporal;
import tools.jackson.databind.ext.javatime.deser.InstantDeserializer;

/** Deserializes Java time values, including RFC 822 zero-offset timestamps. */
public class CustomInstantDeserializer<T extends Temporal> extends InstantDeserializer<T> {
  public static final CustomInstantDeserializer<Instant> INSTANT =
      new CustomInstantDeserializer<>(InstantDeserializer.INSTANT, DateTimeFormatter.ISO_INSTANT);
  public static final CustomInstantDeserializer<OffsetDateTime> OFFSET_DATE_TIME =
      new CustomInstantDeserializer<>(InstantDeserializer.OFFSET_DATE_TIME, DateTimeFormatter.ISO_OFFSET_DATE_TIME);
  public static final CustomInstantDeserializer<ZonedDateTime> ZONED_DATE_TIME =
      new CustomInstantDeserializer<>(InstantDeserializer.ZONED_DATE_TIME, DateTimeFormatter.ISO_ZONED_DATE_TIME);

  protected CustomInstantDeserializer(InstantDeserializer<T> base, DateTimeFormatter formatter) {
    super(base, formatter);
  }

  @Override
  public CustomInstantDeserializer<T> withDateFormat(DateTimeFormatter formatter) {
    return new CustomInstantDeserializer<>(this, formatter);
  }
}
